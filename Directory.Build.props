<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaVersion>11.3.18</AvaloniaVersion>
  </PropertyGroup>

  <!-- Read our property-only profiles before PackageReference/NuGet evaluation in
       every project in the graph. SDK profile imports happen too late for this. -->
  <PropertyGroup>
    <_OneLauncherProfileName Condition="'$(PublishProfile)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(PublishProfile)'))</_OneLauncherProfileName>
    <!-- VS can pass the profile path instead of the CLI PublishProfile name. -->
    <_OneLauncherProfileName Condition="'$(_OneLauncherProfileName)' == '' and '$(WebPublishProfileFile)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(WebPublishProfileFile)'))</_OneLauncherProfileName>
    <_OneLauncherProfileName Condition="'$(_OneLauncherProfileName)' == '' and '$(PublishProfileFullPath)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(PublishProfileFullPath)'))</_OneLauncherProfileName>
    <_OneLauncherSharedProfile Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_OneLauncherProfileName)', '^(WindowsAot|WindowsJit|LinuxAot|LinuxJit|MacOSAot|MacOSJit|FolderProfile|FolderProfile1|FolderProfileAOTWINDOWS|NativeAotSingleFile)$'))">$(MSBuildThisFileDirectory)OneLauncher.Desktop/Properties/PublishProfiles/$(_OneLauncherProfileName).pubxml</_OneLauncherSharedProfile>
  </PropertyGroup>
  <Import Project="$(_OneLauncherSharedProfile)" Condition="'$(_OneLauncherSharedProfile)' != ''" />
  <PropertyGroup Condition="'$(_OneLauncherSharedProfile)' != ''">
    <PublishProfileImported>true</PublishProfileImported>
    <PublishProfileFullPath>$(_OneLauncherSharedProfile)</PublishProfileFullPath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)build/TargetPlatform.props" />
</Project>
