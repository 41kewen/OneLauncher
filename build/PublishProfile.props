<Project>
  <!-- Property-only: also imported early by referenced projects during restore. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>$(PublishAot)</PublishTrimmed>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <StripSymbols>false</StripSymbols>
    <PublishDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/publish/$(RuntimeIdentifier)/$(OneLauncherCompilationMode)/</PublishDir>
  </PropertyGroup>
</Project>
