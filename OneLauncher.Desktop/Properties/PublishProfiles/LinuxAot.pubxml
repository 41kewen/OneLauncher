<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <OneLauncherProfileOS>Linux</OneLauncherProfileOS>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <OneLauncherCompilationMode>aot</OneLauncherCompilationMode>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <Import Project="../../../build/PublishProfile.props" />
</Project>
