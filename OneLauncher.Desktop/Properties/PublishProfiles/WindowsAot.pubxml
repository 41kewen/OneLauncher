<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- VS discovers profiles from these local properties, before evaluating imports. -->
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <OneLauncherProfileOS>Windows</OneLauncherProfileOS>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <OneLauncherCompilationMode>aot</OneLauncherCompilationMode>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Native AOT is already one native executable; keep required native libraries beside it. -->
    <OptimizationPreference>Size</OptimizationPreference>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/publish/$(RuntimeIdentifier)/$(OneLauncherCompilationMode)/</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
  </PropertyGroup>
  <Import Project="../../../build/PublishProfile.props" />
</Project>
