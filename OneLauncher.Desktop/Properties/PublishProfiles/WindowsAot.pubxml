<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <OneLauncherProfileOS>Windows</OneLauncherProfileOS>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <OneLauncherCompilationMode>aot</OneLauncherCompilationMode>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <Import Project="../../../build/PublishProfile.props" />
</Project>
